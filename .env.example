POSTGRES_USER=patagonia
POSTGRES_PASSWORD=patagonia
POSTGRES_DB=patagonia_land
DATABASE_URL=postgresql+psycopg://patagonia:patagonia@postgres:5432/patagonia_land

# Scraping responsable
USER_AGENT=PatagoniaLandBot/0.1 (+contacto en README)
REQUEST_DELAY_SECONDS=2.0
REQUEST_TIMEOUT_SECONDS=20
RESPECT_ROBOTS=true
ENABLE_PLAYWRIGHT=false

# LLM fallback (opcional). Sin clave, el sistema funciona solo con parsers determinísticos.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_ENABLED=false

# Routing (Fase 4)
ORS_API_KEY=

# Alertas Telegram (Fase 3)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# API
API_TOKEN=change-me
